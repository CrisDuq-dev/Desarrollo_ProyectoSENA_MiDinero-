# Copiar a .env y rellenar. Nunca subir .env a git.

PORT=4000
NODE_ENV=development

# MySQL (XAMPP)
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=mi_dinero_plus
DB_PORT=3306

# JWT — mínimo 32 caracteres aleatorios
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio_32chars
# Access token (cookie httpOnly). Con refresh tokens: 15 minutos.
JWT_EXPIRES_IN=15m
# Refresh token en días
REFRESH_TOKEN_DAYS=30

# CORS (coma-separado). Con proxy Vite en local no es crítico.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

FRONTEND_URL=http://localhost:5173

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Groq (asistente IA)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Resend (emails)
RESEND_API_KEY=
EMAIL_FROM=MiDinero+ <onboarding@resend.dev>
