# Copy to .env and fill. Never upload .env to git.

PORT=4000
NODE_ENV=development
# Producción (Render): NODE_ENV=production

# Proxies delante de Node (Render ≈ 1). Afecta rate-limit e IP real.
TRUST_PROXY_HOPS=1

# MySQL (XAMPP en local)
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=mi_dinero_plus
DB_PORT=3306
# TiDB Cloud Starter: DB_PORT=4000
# TLS obligatorio en TiDB; en local dejar false
DB_SSL=false

JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio_32chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30

CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Producción: CORS_ORIGIN=https://TU-APP.vercel.app

FRONTEND_URL=http://localhost:5173
# Producción: FRONTEND_URL=https://TU-APP.vercel.app

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
# Producción: GOOGLE_CALLBACK_URL=https://TU-APP.vercel.app/api/auth/google/callback

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

RESEND_API_KEY=
MAIL_FROM=MiDinero+ <onboarding@resend.dev>